<?xml version="1.0" encoding="utf-8"?>
<!-- Жанровый чип: фон зависит от selected/focused, поэтому состояние
     не приходится переключать из кода по кусочкам. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="23dp" />
            <stroke android:width="3dp" android:color="@color/white" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface2" />
            <corners android:radius="23dp" />
            <stroke android:width="3dp" android:color="@color/white" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="23dp" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="23dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
