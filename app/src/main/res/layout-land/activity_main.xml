<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <!-- Постоянный плеер слева: ТВ, магнитолы, телефон в ландшафте. -->
    <LinearLayout
        android:id="@+id/playerPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="42"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:text="@string/header_title"
                android:textColor="@color/text"
                android:textSize="26sp" />

            <ImageButton
                android:id="@+id/refresh"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/refresh"
                android:focusable="true"
                android:foreground="@drawable/bg_focus_circle"
                android:padding="10dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/coverBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <com.promodj.trendy.RoundedImageView
                android:id="@+id/miniCover"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:elevation="14dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_cover_placeholder"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/miniInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:focusable="true"
            android:foreground="@drawable/bg_focus_ring"
            android:nextFocusDown="@id/miniProgress"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/miniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="@string/nothing_playing"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/miniArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/miniProgress"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:nextFocusDown="@id/miniPlay"
            android:nextFocusUp="@id/miniInfo"
            android:foreground="@drawable/bg_focus_ring"
            android:max="1000"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progress="0"
            android:progressBackgroundTint="#2AFFFFFF"
            android:progressTint="@color/accent"
            android:splitTrack="false"
            android:thumbTint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/miniTimeCurrent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/miniTimeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/miniPrev"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/prev"
                android:focusable="true"
                android:foreground="@drawable/bg_focus_circle"
                android:padding="12dp"
                android:src="@drawable/ic_prev_white" />

            <ImageButton
                android:id="@+id/miniPlay"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_play_circle"
                android:contentDescription="@string/play"
                android:focusable="true"
                android:foreground="@drawable/bg_focus_circle"
                android:padding="20dp"
                android:src="@drawable/ic_play_white" />

            <ImageButton
                android:id="@+id/miniNext"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:nextFocusRight="@id/list"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/next"
                android:focusable="true"
                android:foreground="@drawable/bg_focus_circle"
                android:padding="12dp"
                android:src="@drawable/ic_next_white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/panelCache"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_button"
                android:nextFocusRight="@id/panelDownload"
                android:drawableStart="@drawable/ic_cache"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:foreground="@drawable/bg_focus_ring"
                android:gravity="center"
                android:text="@string/cache"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/panelDownload"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_button"
                android:nextFocusRight="@id/list"
                android:drawableStart="@drawable/ic_download"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:foreground="@drawable/bg_focus_ring"
                android:gravity="center"
                android:text="@string/download"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#1FFFFFFF" />

    <!-- Список справа. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="58"
        android:orientation="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/genreRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/filterBar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_filter"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="true"
                android:nextFocusDown="@id/list"
                android:fontFamily="sans-serif-medium"
                android:foreground="@drawable/bg_focus_ring"
                android:gravity="center"
                android:text="@string/filter_all"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/filterMixes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="true"
                android:nextFocusDown="@id/list"
                android:fontFamily="sans-serif-medium"
                android:foreground="@drawable/bg_focus_ring"
                android:gravity="center"
                android:text="@string/filter_mixes"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/filterTracks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:focusable="true"
                android:nextFocusDown="@id/list"
                android:fontFamily="sans-serif-medium"
                android:foreground="@drawable/bg_focus_ring"
                android:gravity="center"
                android:text="@string/filter_tracks"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="4dp"
            android:textColor="@color/text_faint"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nextFocusLeft="@id/miniPlay"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:drawSelectorOnTop="true"
                android:listSelector="@drawable/bg_row_focus"
                android:nextFocusUp="@id/filterAll"
                android:paddingBottom="10dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:alpha="0.8"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_note_gray" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/empty_title"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/empty_text"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/retry"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_pill_button"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="@drawable/bg_focus_ring"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/retry"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
