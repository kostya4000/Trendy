<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/playerBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.22"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_overlay" />

    <LinearLayout
        android:id="@+id/playerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="44dp"
                android:focusable="true"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:foreground="@drawable/bg_focus_circle"
                android:padding="10dp"
                android:src="@drawable/ic_back_white"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:text="@string/now_playing"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium" />

            <ImageButton
                android:id="@+id/favorite"
                android:layout_width="44dp"
                android:focusable="true"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:foreground="@drawable/bg_focus_circle"
                android:padding="10dp"
                android:src="@drawable/ic_heart_outline"
                android:contentDescription="@string/favorite_add" />

            <ImageButton
                android:id="@+id/share"
                android:layout_width="44dp"
                android:focusable="true"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:foreground="@drawable/bg_focus_circle"
                android:padding="10dp"
                android:src="@drawable/ic_share"
                android:contentDescription="@string/share" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <com.promodj.trendy.RoundedImageView
                    android:id="@+id/cover"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:elevation="18dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_cover_placeholder"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:layout_marginStart="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seek"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="8dp"
                    android:foreground="@drawable/bg_focus_ring"
                    android:max="1000"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progress="0"
                    android:progressBackgroundTint="#2AFFFFFF"
                    android:progressTint="@color/accent"
                    android:splitTrack="false"
                    android:thumbTint="@color/accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/timeCurrent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0:00"
                        android:textColor="@color/text_faint"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/timeTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/text_faint"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/prev"
                        android:layout_width="44dp"
                        android:focusable="true"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_round_button"
                        android:foreground="@drawable/bg_focus_circle"
                        android:padding="12dp"
                        android:src="@drawable/ic_prev_white"
                        android:contentDescription="@string/prev" />

                    <ImageButton
                        android:id="@+id/play"
                        android:layout_width="56dp"
                        android:focusable="true"
                        android:layout_height="56dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_play_circle"
                        android:foreground="@drawable/bg_focus_circle"
                        android:padding="20dp"
                        android:src="@drawable/ic_play_white"
                        android:contentDescription="@string/play" />

                    <ImageButton
                        android:id="@+id/next"
                        android:layout_width="44dp"
                        android:focusable="true"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_round_button"
                        android:foreground="@drawable/bg_focus_circle"
                        android:padding="12dp"
                        android:src="@drawable/ic_next_white"
                        android:contentDescription="@string/next" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cache"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_cache"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:foreground="@drawable/bg_focus_ring"
                android:gravity="center"
                android:text="@string/cache"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/download"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_download"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:foreground="@drawable/bg_focus_ring"
                android:gravity="center"
                android:text="@string/download"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/openSite"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_open"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:foreground="@drawable/bg_focus_ring"
                android:gravity="center"
                android:text="@string/open_site"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
