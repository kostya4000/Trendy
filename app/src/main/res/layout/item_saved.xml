<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <com.promodj.trendy.RoundedImageView
        android:id="@+id/savedCover"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_cover_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/savedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/savedSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/savedDelete"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_pill_button"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:foreground="@drawable/bg_focus_ring"
        android:gravity="center"
        android:minWidth="76dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/settings_delete"
        android:textColor="@color/accent"
        android:textSize="12sp" />
</LinearLayout>
