<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/playerBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.22"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_overlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="44dp"
                android:focusable="true"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:foreground="@drawable/bg_focus_circle"
                android:padding="10dp"
                android:src="@drawable/ic_back_white"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:text="@string/now_playing"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium" />

            <ImageButton
                android:id="@+id/favorite"
                android:layout_width="44dp"
                android:focusable="true"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:foreground="@drawable/bg_focus_circle"
                android:padding="10dp"
                android:src="@drawable/ic_heart_outline"
                android:contentDescription="@string/favorite_add" />

            <ImageButton
                android:id="@+id/share"
                android:layout_width="44dp"
                android:focusable="true"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:foreground="@drawable/bg_focus_circle"
                android:padding="10dp"
                android:src="@drawable/ic_share"
                android:contentDescription="@string/share" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="120dp">

            <com.promodj.trendy.RoundedImageView
                android:id="@+id/cover"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center"
                android:elevation="18dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_cover_placeholder"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/text"
            android:textSize="21sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:foreground="@drawable/bg_focus_ring"
            android:max="1000"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progress="0"
            android:progressBackgroundTint="#2AFFFFFF"
            android:progressTint="@color/accent"
            android:splitTrack="false"
            android:thumbTint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timeCurrent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/timeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/prev"
                android:layout_width="52dp"
                android:focusable="true"
                android:layout_height="52dp"
                android:background="@drawable/bg_round_button"
                android:foreground="@drawable/bg_focus_circle"
                android:padding="13dp"
                android:src="@drawable/ic_prev_white"
                android:contentDescription="@string/prev" />

            <ImageButton
                android:id="@+id/play"
                android:layout_width="72dp"
                android:focusable="true"
                android:layout_height="72dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/bg_play_circle"
                android:foreground="@drawable/bg_focus_circle"
                android:padding="22dp"
                android:src="@drawable/ic_play_white"
                android:contentDescription="@string/play" />

            <ImageButton
                android:id="@+id/next"
                android:layout_width="52dp"
                android:focusable="true"
                android:layout_height="52dp"
                android:background="@drawable/bg_round_button"
                android:foreground="@drawable/bg_focus_circle"
                android:padding="13dp"
                android:src="@drawable/ic_next_white"
                android:contentDescription="@string/next" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cache"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_cache"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:foreground="@drawable/bg_focus_ring"
                android:gravity="center"
                android:text="@string/cache"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/download"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_download"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:foreground="@drawable/bg_focus_ring"
                android:gravity="center"
                android:text="@string/download"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/openSite"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_button"
                android:drawableStart="@drawable/ic_open"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:foreground="@drawable/bg_focus_ring"
                android:gravity="center"
                android:text="@string/open_site"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
